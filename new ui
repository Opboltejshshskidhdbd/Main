-- UI Library for Galaxy-Themed Exploit UI
local GalaxyUI = {}

-- Function to create a window
function GalaxyUI:createWindow(windowName)
    local ScreenGui = Instance.new("ScreenGui")
    local WindowFrame = Instance.new("Frame")
    local Title = Instance.new("TextLabel")

    ScreenGui.Name = windowName
    ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    
    -- Main Window Frame
    WindowFrame.Name = "WindowFrame"
    WindowFrame.Parent = ScreenGui
    WindowFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 50)
    WindowFrame.Size = UDim2.new(0, 400, 0, 300)
    WindowFrame.Position = UDim2.new(0.5, -200, 0.5, -150)
    WindowFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    
    -- Title of the Window
    Title.Name = "Title"
    Title.Parent = WindowFrame
    Title.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Title.Size = UDim2.new(1, 0, 0, 50)
    Title.Font = Enum.Font.SourceSansBold
    Title.Text = windowName
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 24
    
    return WindowFrame
end

-- Function to create a tab
function GalaxyUI:CreateTab(window, tabName)
    local TabButton = Instance.new("TextButton")
    
    TabButton.Name = tabName
    TabButton.Parent = window
    TabButton.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
    TabButton.Size = UDim2.new(0, 100, 0, 40)
    TabButton.Position = UDim2.new(0, 0, 0, 50)
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.Font = Enum.Font.SourceSans
    TabButton.TextSize = 18
    
    return TabButton
end

-- Function to create a button
function GalaxyUI:CreateButton(tab, buttonText, callback)
    local Button = Instance.new("TextButton")
    local UIGradient = Instance.new("UIGradient")
    local UICorner = Instance.new("UICorner")

    Button.Parent = tab
    Button.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
    Button.Size = UDim2.new(0, 200, 0, 50)
    Button.Position = UDim2.new(0, 10, 0, 100)
    Button.Text = ""
    
    local ButtonText = Instance.new("TextLabel")
    ButtonText.Parent = Button
    ButtonText.Size = UDim2.new(1, 0, 1, 0)
    ButtonText.BackgroundTransparency = 1
    ButtonText.Text = buttonText
    ButtonText.TextColor3 = Color3.fromRGB(255, 255, 255)
    ButtonText.Font = Enum.Font.SourceSansBold
    ButtonText.TextSize = 18
    
    UIGradient.Parent = Button
    UIGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 30)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(50, 0, 100)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 0, 150))
    }
    
    UICorner.CornerRadius = UDim.new(0, 25)
    UICorner.Parent = Button
    
    Button.MouseButton1Click:Connect(callback)
end

-- Function to create a toggle
function GalaxyUI:CreateToggle(tab, toggleText, callback)
    local ToggleButton = Instance.new("TextButton")
    local ToggleKnob = Instance.new("Frame")
    local UIGradient = Instance.new("UIGradient")
    local UICorner = Instance.new("UICorner")

    ToggleButton.Parent = tab
    ToggleButton.Size = UDim2.new(0, 80, 0, 40)
    ToggleButton.Position = UDim2.new(0, 10, 0, 160)
    ToggleButton.BackgroundColor3 = Color3.new(0, 0, 0)
    ToggleButton.Text = ""

    ToggleKnob.Parent = ToggleButton
    ToggleKnob.Size = UDim2.new(0, 36, 1, -4)
    ToggleKnob.Position = UDim2.new(0, 2, 0, 2)
    ToggleKnob.BackgroundColor3 = Color3.new(1, 1, 1)
    ToggleKnob.BorderSizePixel = 0

    UIGradient.Parent = ToggleButton
    UIGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 50)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(50, 0, 100)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 0, 150))
    }

    UICorner.CornerRadius = UDim.new(0, 20)
    UICorner.Parent = ToggleButton

    local KnobCorner = UICorner:Clone()
    KnobCorner.Parent = ToggleKnob

    local toggleEnabled = false

    local function toggleAnimation(isEnabled)
        if isEnabled then
            ToggleKnob:TweenPosition(UDim2.new(1, -38, 0, 2), "Out", "Quad", 0.3, true)
            UIGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 50, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 100, 50)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 150, 100))
            }
            ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        else
            ToggleKnob:TweenPosition(UDim2.new(0, 2, 0, 2), "Out", "Quad", 0.3, true)
            UIGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 0, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(100, 50, 0)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 100, 0))
            }
            ToggleButton.BackgroundColor3 = Color3.new(0, 0, 0)
        end
    end

    ToggleButton.MouseButton1Click:Connect(function()
        toggleEnabled = not toggleEnabled
        toggleAnimation(toggleEnabled)
        callback(toggleEnabled)
    end)
end