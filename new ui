-- UI Library Module
local UiLibrary = {}

function UiLibrary:CreateWindow(windowName)
    local window = {}
    window.Name = windowName
    window.Tabs = {}
    
    function window:CreateTab(tabName, tabIcon)
        local tab = {}
        tab.Name = tabName
        tab.Icon = tabIcon
        tab.Elements = {}
        
        -- Create a frame to hold all elements in this tab
        local tabFrame = Instance.new("Frame")
        tabFrame.Name = tabName .. "Frame"
        tabFrame.Size = UDim2.new(1, 0, 1, -50)
        tabFrame.Position = UDim2.new(0, 0, 0, 50)
        tabFrame.Visible = false  -- Initially hidden
        tabFrame.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild(window.Name)

        function tab:CreateButton(buttonName, callback)
            local button = Instance.new("TextButton")
            button.Name = buttonName
            button.Text = buttonName
            button.Size = UDim2.new(0, 200, 0, 50)
            button.Parent = tabFrame  -- Parent button to the tab's frame
            
            button.MouseButton1Click:Connect(function()
                callback()
            end)
            
            table.insert(self.Elements, button)
        end
        
        function tab:CreateToggle(toggleName, callback)
            local toggleEnabled = false
            local toggle = Instance.new("TextButton")
            toggle.Name = toggleName
            toggle.Text = toggleName
            toggle.Size = UDim2.new(0, 80, 0, 40)
            toggle.Parent = tabFrame  -- Parent toggle to the tab's frame
            
            toggle.MouseButton1Click:Connect(function()
                toggleEnabled = not toggleEnabled
                callback(toggleEnabled)
            end)
            
            table.insert(self.Elements, toggle)
        end
        
        table.insert(window.Tabs, tab)
        return tab
    end
    
    function window:Display()
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = self.Name
        screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
        
        local topBar = Instance.new("Frame")
        topBar.Name = "TopBar"
        topBar.Size = UDim2.new(1, 0, 0, 50)
        topBar.Position = UDim2.new(0, 0, 0, 0)
        topBar.BackgroundColor3 = Color3.fromRGB(25, 25, 50)
        topBar.Parent = screenGui

        for i, tab in ipairs(self.Tabs) do
            local tabButton = Instance.new("TextButton")
            tabButton.Name = tab.Name
            tabButton.Text = tab.Name
            tabButton.Size = UDim2.new(0, 100, 0, 50)
            tabButton.Position = UDim2.new(0, (i-1)*100, 0, 0)  -- Positioning each tab button next to each other
            tabButton.Parent = topBar
            
            tabButton.MouseButton1Click:Connect(function()
                for _, otherTab in ipairs(window.Tabs) do
                    local otherTabFrame = game.Players.LocalPlayer.PlayerGui[window.Name]:FindFirstChild(otherTab.Name .. "Frame")
                    otherTabFrame.Visible = false  -- Hide all tab frames
                end
                local currentTabFrame = game.Players.LocalPlayer.PlayerGui[window.Name]:FindFirstChild(tab.Name .. "Frame")
                currentTabFrame.Visible = true  -- Show current tab frame
            end)
        end
        
        -- Initially display the first tab's content
        if #self.Tabs > 0 then
            local firstTabFrame = game.Players.LocalPlayer.PlayerGui[window.Name]:FindFirstChild(self.Tabs[1].Name .. "Frame")
            firstTabFrame.Visible = true
        end
    end
    
    return window
end

return UiLibrary