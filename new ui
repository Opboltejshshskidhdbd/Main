local UiLibrary = {}

function UiLibrary:CreateWindow(windowName)
    local window = {}
    window.Name = windowName
    window.Tabs = {}
    
    function window:CreateTab(tabName, tabIcon)
        local tab = {}
        tab.Name = tabName
        tab.Icon = tabIcon
        tab.Elements = {}
        
        function tab:CreateButton(buttonName, callback)
            local button = Instance.new("TextButton")
            button.Name = buttonName
            button.Text = buttonName
            button.Size = UDim2.new(0, 200, 0, 50)
            
            -- Parent button to the ScreenGui (Window) after it's created
            button.Parent = game.Players.LocalPlayer.PlayerGui:WaitForChild(window.Name)
            
            button.MouseButton1Click:Connect(function()
                callback()
            end)
            
            table.insert(self.Elements, button)
        end
        
        function tab:CreateToggle(toggleName, callback)
            local toggleEnabled = false
            local toggle = Instance.new("TextButton")
            toggle.Name = toggleName
            toggle.Text = toggleName
            toggle.Size = UDim2.new(0, 80, 0, 40)
            
            -- Parent toggle to the ScreenGui (Window) after it's created
            toggle.Parent = game.Players.LocalPlayer.PlayerGui:WaitForChild(window.Name)
            
            toggle.MouseButton1Click:Connect(function()
                toggleEnabled = not toggleEnabled
                callback(toggleEnabled)
            end)
            
            table.insert(self.Elements, toggle)
        end
        
        table.insert(self.Tabs, tab)
        return tab
    end
    
    function window:Display()
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = self.Name
        screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
        
        -- Create buttons for each tab in the ScreenGui
        for _, tab in ipairs(self.Tabs) do
            local tabButton = Instance.new("TextButton")
            tabButton.Name = tab.Name
            tabButton.Text = tab.Name
            tabButton.Size = UDim2.new(0, 100, 0, 50)
            tabButton.Parent = screenGui
            
            tabButton.MouseButton1Click:Connect(function()
                for _, element in ipairs(tab.Elements) do
                    element.Visible = not element.Visible
                end
            end)
        end
    end
    
    return window
end

return UiLibrary