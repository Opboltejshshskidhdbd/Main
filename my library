local MyUILib = {}

function MyUILib:MakeWindow(config)
    local window = {}
    
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TitleLabel = Instance.new("TextLabel")
    local TabContainer = Instance.new("Frame")
    local UIListLayout = Instance.new("UIListLayout")

    ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.ResetOnSpawn = false

    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Frame.Position = UDim2.new(0.3, 0, 0.2, 0)
    Frame.Size = UDim2.new(0, 500, 0, 400)
    Frame.ClipsDescendants = true

    TitleLabel.Parent = Frame
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0.05, 0, 0.05, 0)
    TitleLabel.Size = UDim2.new(0.9, 0, 0.1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = config.Name or "UI Library"
    TitleLabel.TextColor3 = Color3.fromRGB(232, 232, 232)
    TitleLabel.TextScaled = true

    TabContainer.Parent = Frame
    TabContainer.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    TabContainer.Position = UDim2.new(0.05, 0, 0.2, 0)
    TabContainer.Size = UDim2.new(0.9, 0, 0.1, 0)
    TabContainer.ClipsDescendants = true

    UIListLayout.Parent = TabContainer
    UIListLayout.FillDirection = Enum.FillDirection.Horizontal
    UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0.05, 0)

    function window:MakeTab(config)
        local tab = {}
        local TabButton = Instance.new("TextButton")
        local ContentFrame = Instance.new("Frame")

        TabButton.Parent = TabContainer
        TabButton.Size = UDim2.new(0, 100, 0, 40)
        TabButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        TabButton.Text = config.Name or "Tab"
        TabButton.TextColor3 = Color3.fromRGB(232, 232, 232)
        TabButton.Font = Enum.Font.GothamBold
        TabButton.TextSize = 12
        TabButton.BorderSizePixel = 0

        ContentFrame.Parent = Frame
        ContentFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        ContentFrame.Size = UDim2.new(1, 0, 1, -100)
        ContentFrame.Position = UDim2.new(0, 0, 0.3, 0)
        ContentFrame.Visible = false

        TabButton.MouseButton1Click:Connect(function()
            for _, v in pairs(Frame:GetChildren()) do
                if v:IsA("Frame") and v ~= TabContainer then
                    v.Visible = false
                end
            end
            ContentFrame.Visible = true
        end)

        function tab:AddButton(config)
            local Button = Instance.new("TextButton")
            Button.Parent = ContentFrame
            Button.Size = UDim2.new(0, 200, 0, 50)
            Button.Position = UDim2.new(0.5, -100, 0, 0)
            Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            Button.Text = config.Name or "Button"
            Button.TextColor3 = Color3.fromRGB(232, 232, 232)
            Button.Font = Enum.Font.GothamBold
            Button.TextSize = 14
            Button.BorderSizePixel = 0

            Button.MouseButton1Click:Connect(function()
                pcall(config.Callback)
            end)
        end

        function tab:AddToggle(config)
            local ToggleButton = Instance.new("TextButton")
            local ToggleKnob = Instance.new("Frame")
            
            ToggleButton.Parent = ContentFrame
            ToggleButton.Size = UDim2.new(0, 80, 0, 40)
            ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            ToggleButton.Text = config.Name or "Toggle"
            ToggleButton.TextColor3 = Color3.fromRGB(232, 232, 232)
            ToggleButton.Font = Enum.Font.GothamBold
            ToggleButton.TextSize = 12
            ToggleButton.BorderSizePixel = 0

            ToggleKnob.Parent = ToggleButton
            ToggleKnob.Size = UDim2.new(0, 36, 1, -4)
            ToggleKnob.Position = UDim2.new(config.Default and 1 or 0, config.Default and -38 or 2, 0, 2)
            ToggleKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            ToggleKnob.BorderSizePixel = 0

            local toggleEnabled = config.Default or false

            local function toggleAnimation(isEnabled)
                if isEnabled then
                    ToggleKnob:TweenPosition(UDim2.new(1, -38, 0, 2), "Out", "Quad", 0.3, true)
                    ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                else
                    ToggleKnob:TweenPosition(UDim2.new(0, 2, 0, 2), "Out", "Quad", 0.3, true)
                    ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end
            end

            ToggleButton.MouseButton1Click:Connect(function()
                toggleEnabled = not toggleEnabled
                toggleAnimation(toggleEnabled)
                pcall(config.Callback, toggleEnabled)
            end)

            -- Initial state animation
            toggleAnimation(toggleEnabled)
        end

        return tab
    end

    return window
end

return MyUILib